# ==============================================================================
# MEMORYOS Production Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Integration (Server-Side Only - Never prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 2. Sibyl Memory MCP Integration
# ------------------------------------------------------------------------------
# For Vercel / Serverless deployments:
# Deploy `sibyl-server/` to Railway, Render, or Fly.io with a persistent volume,
# then set SIBYL_MCP_URL to your service endpoint:
SIBYL_MCP_URL=https://your-sibyl-service.up.railway.app
SIBYL_API_KEY=your_optional_secret_token_here

# For Local Development / Single Docker Container (leave SIBYL_MCP_URL empty):
# Windows WSL: Automatically spawns `wsl -e /home/<user>/.sibyl-venv/bin/sibyl-memory-mcp`
# Container:   Uses /opt/sibyl-venv/bin/sibyl-memory-mcp with volume mounted at /data

# ------------------------------------------------------------------------------
# 3. Supabase Application Data (Sessions, Messages, State)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
